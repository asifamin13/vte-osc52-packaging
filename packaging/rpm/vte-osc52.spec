%bcond gtk4 1
%bcond vapi 0
%bcond docs 0
%bcond glade 0

# Keep every Meson directory private, including Fedora's absolute defaults.
%global _prefix /opt/vte-osc52
%global _libdir %{_prefix}/lib
%global _sysconfdir %{_prefix}/etc
%global _localstatedir %{_prefix}/var
%global _sharedstatedir %{_prefix}/var/lib

# Private libraries must not satisfy dependencies on system VTE.
%global __provides_exclude_from ^/opt/vte-osc52/lib/.*$

Name:           vte-osc52
Version:        0.84.1
Release:        1.osc52%{?dist}
Summary:        Opt-in VTE with OSC 52 clipboard support
License:        LGPL-3.0-or-later
URL:            https://github.com/asifamin13/vte
# Generated by scripts/build-rpm from the parent repository's recorded gitlink.
Source0:        vte-%{version}.tar.gz
Source1:        vte-osc52-run

BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  meson >= 1.3.2
BuildRequires:  ninja-build
BuildRequires:  gettext
BuildRequires:  python3
BuildRequires:  pkgconf-pkg-config
BuildRequires:  fast_float-devel
BuildRequires:  pkgconfig(fmt) >= 11.0.0
BuildRequires:  pkgconfig(cairo)
BuildRequires:  pkgconfig(cairo-gobject)
BuildRequires:  pkgconfig(gio-2.0) >= 2.72.0
BuildRequires:  pkgconfig(glib-2.0) >= 2.72.0
BuildRequires:  pkgconfig(gobject-2.0)
BuildRequires:  pkgconfig(pango)
BuildRequires:  pkgconfig(libpcre2-8)
BuildRequires:  pkgconfig(liblz4) >= 1.9
BuildRequires:  pkgconfig(simdutf) >= 6.2.0
BuildRequires:  pkgconfig(fribidi)
BuildRequires:  pkgconfig(gnutls)
BuildRequires:  pkgconfig(gtk+-3.0) >= 3.24.0
BuildRequires:  pkgconfig(icu-uc)
BuildRequires:  pkgconfig(libsystemd)
BuildRequires:  pkgconfig(gobject-introspection-1.0)
%if %{with gtk4}
BuildRequires:  pkgconfig(gtk4) >= 4.14.0
%endif
%if %{with vapi}
BuildRequires:  vala
%endif
%if %{with docs}
BuildRequires:  gi-docgen
%endif
# Glade support installs catalog data; it does not compile against Glade.

# GIR references Cairo's typelib, which ELF dependency scanning cannot see.
Requires:       gobject-introspection%{?_isa}

%description
VTE with OSC 52 clipboard support, installed privately under /opt/vte-osc52.
Use vte-osc52-run to opt individual applications into its libraries and typelibs.
System VTE is not replaced.

%prep
%autosetup -n vte-%{version}

%build
%meson --prefix=/opt/vte-osc52 --libdir=lib --sysconfdir=/opt/vte-osc52/etc \
    --wrap-mode=nofallback \
    -Dgtk3=true -Dgir=true \
    -Dgtk4=%{?with_gtk4:true}%{!?with_gtk4:false} \
    -Dvapi=%{?with_vapi:true}%{!?with_vapi:false} \
    -Ddocs=%{?with_docs:true}%{!?with_docs:false} \
    -Dglade=%{?with_glade:true}%{!?with_glade:false}
%meson_build

%install
%meson_install
install -Dpm 0755 %{SOURCE1} %{buildroot}/usr/bin/vte-osc52-run

%check
%meson_test vte:test-parser

%files
/opt/vte-osc52/
/usr/bin/vte-osc52-run

%changelog
* Mon Nov 16 2026 VTE OSC 52 maintainers - 0.84.1-1.osc52
- Package pinned VTE privately with opt-in GTK and binding features.
- Use Fedora's vala package for both valac and vapigen.
- Require the Cairo typelib provider for private GIR consumers.
